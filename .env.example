# Copy to .env (git-ignored). docker-compose.yml reads it; every value has a default, so this is optional.
# The accounts table for the README comes from here (PRD §14, O-4, A40).

# ---- database --------------------------------------------------------------
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint
# Used when running the API outside Docker (uvicorn on your machine, Alembic, the tests' seed).
DATABASE_URL=postgresql+psycopg://waypoint:waypoint@localhost:5432/waypoint

# ---- auth ------------------------------------------------------------------
# Set a long random value anywhere that is not your laptop.
JWT_SECRET=change-me-in-env-change-me-in-env
JWT_TTL_HOURS=12
# One password for the four demo accounts: dispatcher@, loader@, driver@, store@waypoint.demo.
# Loader PINs are fixed (A36): Priya 1234, Ruwan 5678.
DEMO_PASSWORD=waypoint

# ---- web -------------------------------------------------------------------
# JSON list of origins allowed to call the API from a browser.
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

# ---- seed and data ---------------------------------------------------------
# true: migrate then seed on API start (idempotent). The seed needs data/*.csv and the COLUMNS mapping in
# backend/seed/load_reference.py; without the CSVs it falls back to the small PRD 4c reference set.
SEED_ON_START=true
# Where the competition CSVs live when running outside Docker (Compose mounts ./data at /data).
DATA_DIR=../data
UPLOADS_DIR=./uploads
