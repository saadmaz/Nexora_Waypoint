# Copy to .env (git-ignored). docker-compose.yml reads it; every value has a default, so this is optional.
# The accounts table for the README comes from here (PRD §14, O-4, A40).

# ---- database --------------------------------------------------------------
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint
# Used when running the API outside Docker (uvicorn on your machine, Alembic, the tests' seed).
DATABASE_URL=postgresql+psycopg://waypoint:waypoint@localhost:5432/waypoint

# ---- auth ------------------------------------------------------------------
# dev keeps the defaults below usable, so a clean checkout runs with no .env at all.
# Set ENVIRONMENT to anything else (staging, production) and the API refuses to start while
# JWT_SECRET is still one of the values published in this repository.
ENVIRONMENT=dev
# Leave unset on your laptop. Anywhere else, generate one and keep it out of git:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
JWT_TTL_HOURS=12
# One password for the four demo accounts: dispatcher@, loader@, driver@, store@waypoint.demo.
# Loader PINs are fixed (A36): Priya 1234, Ruwan 5678.
DEMO_PASSWORD=waypoint-demo

# ---- web -------------------------------------------------------------------
# JSON list of origins allowed to call the API from a browser.
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

# ---- seed and data ---------------------------------------------------------
# true: migrate then seed on API start (idempotent). The seed needs data/*.csv and the COLUMNS mapping in
# backend/seed/load_reference.py; without the CSVs it falls back to the small PRD 4c reference set.
SEED_ON_START=true
# Where the competition CSVs live when running outside Docker (Compose mounts ./data at /data).
DATA_DIR=../data
UPLOADS_DIR=./uploads

# ---- frontend API mode (read by Vite, so set them in the shell or in frontend/.env.local, not here) ------
# Every role defaults to its mock. Switch one to the real backend with VITE_<ROLE>_API=api. README, "API mode".
# VITE_AUTH_API=mock|api
# VITE_STORE_API=mock|api
# VITE_DRIVER_API=mock|api
# VITE_LOADER_API=mock|api
# VITE_DISPATCHER_API=mock|api      api also reads the clock from the server and routes the presenter control to /demo
# VITE_API_BASE=http://localhost:8000   default in npm run dev; unset in a production build means the same origin
