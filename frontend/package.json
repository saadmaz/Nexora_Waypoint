{
  "name": "waypoint-store-frontend",
  "private": true,
  "sideEffects": ["**/*.css"],
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "dev:https": "vite --mode https",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle.mjs",
    "compare": "node scripts/compare-frames.ts",
    "test:hero": "node scripts/driver-hero-walkthrough.ts",
    "test:offline": "node scripts/driver-offline-shell.ts",
    "test:api-auth": "node scripts/api-auth-check.ts",
    "test:api-roles": "node scripts/api-roles-check.ts",
    "test:api-dispatcher": "node scripts/api-dispatcher-check.ts",
    "test:api-sync": "node scripts/api-sync-check.ts",
    "test:loader-stories": "node scripts/loader-stories.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/noto-sans-sinhala": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "dexie": "^4.4.6",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
